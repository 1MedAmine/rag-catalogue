NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_REASONING_MODE=normal
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_API_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NVIDIA_RERANK_API_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
RAG_CACHE_DIR=.rag_cache
RAG_OCR_MODE=auto
RAG_OCR_LANGUAGE=eng
RAG_OCR_MAX_PAGES=12
RAG_MIN_NATIVE_CHARS=40
RAG_CATALOGUE_PROFILE=auto
RAG_RERANK_BATCH_SIZE=64
